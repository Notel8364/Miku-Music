<Window x:Class="MusicBox.WebLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="内置浏览器登录" Width="700" Height="560"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8" Background="#F3F4F6">
            <TextBlock x:Name="HintText" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="ExtractBtn" Click="ExtractBtn_Click" Padding="14,7"
                    Background="#3C8CFF" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Content="提取登录Cookie"/>
            <Button x:Name="ExternalBtn" Margin="8,0,0,0" Padding="14,7"
                    Background="#E0E0E0" Foreground="#333333" BorderThickness="0" Cursor="Hand"
                    Content="改用系统浏览器登录" Click="ExternalBtn_Click"/>
            <Button x:Name="DownloadRuntimeBtn" Margin="8,0,0,0" Padding="14,7"
                    Background="#2FA84F" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Content="下载并安装 WebView2" ToolTip="下载并静默安装 WebView2 Runtime，完成后自动重试内嵌浏览器。"
                    Click="DownloadRuntimeBtn_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="10,0,10,6" FontSize="12"
                   Foreground="#7a5b00" TextWrapping="Wrap" Visibility="Collapsed"
                   Background="#FFF4D6" Padding="10,7"/>
        <Border>
            <wv2:WebView2 x:Name="Web"/>
        </Border>
    </DockPanel>
</Window>