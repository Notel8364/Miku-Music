<Window x:Class="MusicBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:MusicBox.Services"
        xmlns:local="clr-namespace:MusicBox"
        mc:Ignorable="d"
        Title="Miku Music"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/app.ico"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 背景摆动动画：位移 + 缓慢缩放，AutoReverse 往复，制造「景深在呼吸」的观感 -->
        <Storyboard x:Key="BgMotion">
            <DoubleAnimation Storyboard.TargetName="BgTranslate" Storyboard.TargetProperty="X"
                             From="-26" To="26" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleX"
                             From="1.16" To="1.22" Duration="0:0:30" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="BgScale" Storyboard.TargetProperty="ScaleY"
                             From="1.16" To="1.22" Duration="0:0:30" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 滑轨模板 -->
        <ControlTemplate x:Key="RepeatBtnTemplate" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>
        <ControlTemplate x:Key="SliderFillTemplate" TargetType="RepeatButton">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Height="7" VerticalAlignment="Center"/>
        </ControlTemplate>
        <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
            <Ellipse x:Name="Dot" Fill="#FFFFFF" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
        </ControlTemplate>

        <Style x:Key="AccentSlider" TargetType="Slider">
            <!-- 轨道做粗一点：现在 4px 细线在深色背景上几乎点不中，
                 用户反馈「跳转选不中有点难受」。Slider 本身 28px 高，
                 Track 撑满，命中区其实一直是 28px，这里把可视轨道加粗到 7px
                 让「能点到的范围」和「看起来能点」一致。 -->
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="7" CornerRadius="4" Background="{DynamicResource SubtleFillHoverBrush}" VerticalAlignment="Center"/>
                            <!-- Track 撑满整个 Slider 高度：只是扩大鼠标命中区域，
                                 里面的填充块/滑块仍各自 VerticalAlignment=Center 居中。 -->
                            <Track x:Name="PART_Track" Height="30" VerticalAlignment="Center">
                                <!-- IsHitTestVisible=False 至关重要：RepeatButton 默认会吃掉鼠标按下
                                     （Slider.IncreaseLarge 没有 CommandParameter 时直接返回 false），
                                     导致 Track 收不到点击、IsMoveToPointEnabled 永远不执行，
                                     表现就是「点轨道没反应 / 点了又弹回去」。 -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False"
                                                  IsHitTestVisible="False"
                                                  Template="{StaticResource SliderFillTemplate}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False"
                                                  IsHitTestVisible="False"
                                                  Template="{StaticResource RepeatBtnTemplate}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Background="White"
                                           Template="{StaticResource SliderThumbTemplate}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形图标按钮：迷你播放器主控。
             悬停/按下不再靠 Trigger 硬切背景色（那样是「啪」一下跳变），
             而是在底层铺一个淡色层 Bd，用 DoubleAnimation 把 Opacity 淡入淡出。 -->
        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="0">
                            <Grid>
                                <!-- 淡化层：默认全透明，悬停时淡入 -->
                                <Border x:Name="Bd" Background="{DynamicResource ControlFillHoverBrush}"
                                        CornerRadius="8" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter" SourceName="Bd">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave" SourceName="Bd">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放/暂停：跟上下首同尺寸同形状、同一个淡化层。
             之前这里是 AccentBrush 实心底 + 独立的 AccentHover/AccentPressed 底，
             结果三个键贴一起时中间那个像贴了块色板。现在去掉独立底色层，
             只把字形染成强调色来区分主操作，悬停淡化跟上下首完全一致。 -->
        <Style x:Key="PlayIconButton" TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- 标题栏搜索框专用模板：全局 TextBox 模板里 PART_ContentHost 带 Margin="9,0,9,0"，
             那个 9px 会把光标推到 15px 处，而提示文字只有 10px，光标就压到字上了。
             这里自己写一个不带内边距的模板，让光标和提示文字严格同一位置。 -->
        <ControlTemplate x:Key="TitleSearchBoxTemplate" TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
        </ControlTemplate>

        <Style x:Key="SmallRoundButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 药丸按钮：卡片内的次级操作 -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏窗口控制按钮（34px 标题栏） -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏搜索框里那个小按钮：比 CaptionButton 小一圈，好放进 24px 高的框里 -->
        <Style x:Key="TitleBarIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航项：左侧 3px 强调条 + 淡化层。
             锐角做法：CornerRadius=0 只是不画圆角，WPF 默认还是抗锯齿渲染，
             半透明色块边缘看着仍是「发虚」的，所以再给 EdgeMode=Aliased 关掉抗锯齿。
             选中淡层/强调条的淡入淡出用 DoubleAnimation，不再硬切。 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                            <Grid>
                                <!-- 悬停淡化层：默认透明，MouseEnter 淡入 -->
                                <Border x:Name="HoverLayer" Background="{DynamicResource SubtleFillHoverBrush}"
                                        CornerRadius="0" Opacity="0"
                                        RenderOptions.EdgeMode="Aliased"/>
                                <!-- 选中淡化层：锐角 + 关抗锯齿，选中时淡入。
                                     之前只有一层很淡的填充，方角和圆角几乎看不出差别，
                                     所以「锐角化」等于没做。这里补一圈 1px 硬边描线：
                                     直角轮廓一旦有硬边，一眼就能和圆角方案区分开。 -->
                                <Border x:Name="SelectLayer" Background="{DynamicResource AccentSubtleBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="0" Opacity="0"
                                        RenderOptions.EdgeMode="Aliased"/>
                                <Rectangle x:Name="Accent" Width="3" HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                                <ContentPresenter Margin="16,0,10,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停：淡化层淡入（缩放动画已按要求去掉） -->
                            <EventTrigger RoutedEvent="MouseEnter" SourceName="Bd">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave" SourceName="Bd">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Accent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Accent 竖线也必须一起淡出。之前 ExitActions 里
                                                 只写了 SelectLayer，导致选中过的每一项左侧
                                                 那条 3px 竖线都会永久停在 opacity=1。 -->
                                            <DoubleAnimation Storyboard.TargetName="Accent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 标题栏高度对齐 MhyunBox；内容卡片跨行覆盖，页内再留 34px 占位行 -->
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 整窗底色：卡片没铺满处（导航栏、窗口圆角外）的兜底色 -->
        <Border x:Name="PageBackdrop" Grid.RowSpan="2" Background="{DynamicResource PageBgBrush}"/>

        <!-- 左侧导航底板：跨标题栏行，长度=导航宽度，右缘恰好接内容卡片 -->
        <Border x:Name="PaneBackdrop" Grid.RowSpan="2" Width="160"
                HorizontalAlignment="Left" Background="{DynamicResource PaneBgBrush}"/>

        <!-- ============ 左侧导航（设置固定在左下角，其余按顺序排上面） ============ -->
        <Grid Grid.Row="1" Width="160" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="NavList" Grid.Row="0" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     SelectionChanged="NavList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <!-- 单独的 ListBox：设置永远在左下角，不跟着上面几项一起滚 -->
            <ListBox x:Name="NavBottomList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     SelectionChanged="NavList_SelectionChanged"
                     Margin="0,0,0,10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <!-- ============ 内容卡片：跨标题栏行，从导航右缘起铺到窗口右边 ============ -->
        <!-- 放在 NavList 之后绘制：卡片左缘比导航底板窄 3px，正好压住导航右缘，
             形成 MhyunBox 那种「卡片盖住面板一点」的叠压关系。 -->
        <Border x:Name="ContentCard" Grid.RowSpan="2" Margin="157,0,0,0"
                Background="Transparent"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid ClipToBounds="True">
                <!-- 背景宿主：静态图片 / 全窗视频，裁到卡片范围内（不再铺到导航栏后面） -->
                <Grid x:Name="BackgroundHost" Grid.RowSpan="3" IsHitTestVisible="False">
                    <Image x:Name="BgImage" Stretch="UniformToFill">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BgScale" ScaleX="1.16" ScaleY="1.16"/>
                                <TranslateTransform x:Name="BgTranslate"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <MediaElement x:Name="BgVideo" Stretch="UniformToFill"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                  MediaEnded="BgVideo_MediaEnded" Visibility="Collapsed" Opacity="0"/>
                    <!-- 背景压暗层：对应设置里的「背景暗度」 -->
                    <Border x:Name="BgDark" Background="#5E0F0F0F"/>
                    <!-- 卡片蒙版：对应 MhyunBox 的 ContentCard.Background。
                         没有背景图时用 WinUI 的「半透明白 5%」；
                         有背景图时改成 75% 不透明的近黑（见 ApplyBackground），
                         否则纯白背景图会把上面的白色文字吃掉。 -->
                    <Border x:Name="BgCardMask" Background="{DynamicResource CardBgBrush}"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 页面内容。下边距 18→8：原来列表底部和底部迷你播放栏之间
                         空掉一截，看着像列表没铺到底。收窄后列表能多露一两行，
                         而且视口变高只会更不容易出滚动条。 -->
                    <Grid Grid.Row="1" Margin="28,16,28,8" PreviewMouseWheel="Content_PreviewMouseWheel">
                        <ContentControl x:Name="ContentHost"/>
                    </Grid>

                    <!-- ============ 底部迷你播放栏（收在卡片内） ============ -->
                    <Border x:Name="MiniPlayerHost" Grid.Row="2"
                            Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="0,1,0,0"
                            Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：曲目名 / 进度（设置入口已移到左下角导航，这里只留播放信息） -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,18,0">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock x:Name="MiniTimeText" DockPanel.Dock="Right" MinWidth="122"
                                               FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextAlignment="Right" Text="00:00 / 00:00"/>
                                    <!-- 取流/下载提示。点在线歌曲后要等直链和下载，
                                         常常好几秒到几十秒（VIP 更久），
                                         原来这段时间标题栏完全没变化，像卡死，
                                         用户就会反复点同一首，结果把正在播的歌顶掉。
                                         这里实时显示「正在取流」+ 转圈动画。 -->
                                    <Border x:Name="FetchIndicator" DockPanel.Dock="Right"
                                            Visibility="Collapsed" CornerRadius="0" Margin="0,0,8,0"
                                            Padding="6,1" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FetchSpinner" Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform x:Name="FetchSpinnerRotate"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="FetchText" Margin="4,0,0,0" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="MiniTrackText" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                                <!-- 进度条：IsMoveToPointEnabled 让点击轨道任意位置直接跳过去；
                                     拖动完全交给 Slider 自己的 Thumb 逻辑处理。
                                     之前在 PreviewMouseLeftButtonDown 里 e.Handled=true 把事件吃掉了，
                                     Thumb 从来没拿到鼠标，鼠标一拖出轨道就收不到事件 → 卡住没反应。 -->
                                <Slider x:Name="MiniProgressSlider" Style="{StaticResource AccentSlider}"
                                        Height="18" Minimum="0" Maximum="1" Value="0"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="MiniProgressSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="MiniProgressSlider_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="MiniProgressSlider_LostMouseCapture"
                                        ValueChanged="MiniProgressSlider_ValueChanged"/>
                            </StackPanel>

                            <!-- 中：上一首 / 播放暂停 / 下一首。三个键贴在一起，尺寸一致（34px），
                                 播放键只用强调色区分，不再是 58px 的大圆。 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MiniPrevButton" Style="{StaticResource RoundIconButton}" Click="MiniPrevButton_Click"
                                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_prev]}">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="MiniPlayPauseButton" Style="{StaticResource PlayIconButton}"
                                        Click="MiniPlayPauseButton_Click"
                                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_playpause]}">
                                    <TextBlock x:Name="MiniPlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="MiniNextButton" Style="{StaticResource RoundIconButton}" Click="MiniNextButton_Click"
                                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_next]}">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- 右：收藏 / 播放模式 / 音量 / 音效 / 最近播放 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,2,0">
                                <Button x:Name="MiniFavButton" Style="{StaticResource SmallRoundButton}" Click="MiniFavButton_Click"
                                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_fav]}">
                                    <TextBlock x:Name="MiniFavGlyph" Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- 播放顺序（随机/列表循环/单曲循环，点击循环切换） -->
                                <Button x:Name="MiniOrderButton" Margin="4,0,0,0" Style="{StaticResource SmallRoundButton}"
                                        Click="MiniOrderButton_Click"
                                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_mode]}">
                                    <TextBlock x:Name="MiniOrderGlyph" Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- 音量（点击向上弹垂直滑条：下低上高，可点选定位） -->
                                <Grid VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Button x:Name="MiniVolumeButton" Style="{StaticResource SmallRoundButton}" Click="MiniVolumeButton_Click"
                                            ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_volume]}">
                                        <TextBlock x:Name="MiniVolumeGlyph" Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Popup x:Name="VolumePopup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Top" PlacementTarget="{Binding ElementName=MiniVolumeButton}"
                                           PopupAnimation="Slide" VerticalOffset="-6">
                                        <Border Background="{DynamicResource FlyoutBgBrush}"
                                                BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="8,10">
                                            <StackPanel>
                                                <Slider x:Name="VolumePopupSlider" Orientation="Vertical" Width="26" Height="150"
                                                        IsMoveToPointEnabled="True"
                                                        Minimum="0" Maximum="100"
                                                        ValueChanged="VolumePopupSlider_ValueChanged"/>
                                                <!-- 原来的百分比数字去掉了：Popup 宽度是跟着内容走的，
                                                     "99%" 变成 "100%" 时 TextBlock 宽了 1 个字符，
                                                     整个浮层会跟着重新居中，看起来就是「突然一抖」。
                                                     现在用固定宽度的圆点刻度代替，宽度恒定不变。 -->
                                                <Grid Height="4" Margin="0,6,0,0" Width="150">
                                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource SubtleFillHoverBrush}"/>
                                                    <Border x:Name="VolumeFillBar" Height="4" CornerRadius="2"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                                            Background="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- 音效（开着音效加强时图标着色） -->
                                <Grid VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Button x:Name="MiniFxButton" Style="{StaticResource SmallRoundButton}" Click="MiniFxButton_Click"
                                            ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[mt_fx]}">
                                        <TextBlock x:Name="MiniFxGlyph" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Popup x:Name="FxPopup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Top" PlacementTarget="{Binding ElementName=MiniFxButton}"
                                           PopupAnimation="Fade" VerticalOffset="-6">
                                        <Border Background="{DynamicResource FlyoutBgBrush}"
                                                BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" MinWidth="170">
                                            <!-- FxPopupPanel 会被 BuildFxPopup 清空后重填（预设单选 + 分隔线 + EQ 按钮），
                                                 所以 EQ 按钮必须待在这个面板里，不能挪到外层。 -->
                                            <StackPanel x:Name="FxPopupPanel">
                                                <StackPanel.Resources>
                                                    <Style TargetType="RadioButton">
                                                        <Setter Property="Margin" Value="6,3"/>
                                                        <Setter Property="Padding" Value="8,5"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Separator Margin="6,4"/>
                                                <Button x:Name="FxPopupEqButton" Margin="6,2,6,6" Padding="10,6" HorizontalAlignment="Stretch"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Click="FxPopupEqButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="均衡器（10段 EQ）" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- 桌面歌词开关。放在这一排最右边：歌词是「看现在在放什么」的
                                     全局功能，跟底部播放栏同一条视线最省事，不用去歌单里翻。
                                     原来这个位置是「最近播放」按钮，重复了——左��导航本来就有。 -->
                                <Button x:Name="MiniLyricButton" Margin="6,0,0,0" Style="{StaticResource SmallRoundButton}"
                                        Click="MiniLyricButton_Click"
                                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[lyric_toggle_off]}">
                                    <TextBlock x:Name="MiniLyricGlyph" Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 标题栏：左图标+标题（可拖动区），中间搜索框，右窗口控制 ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Image x:Name="AppTitleIcon" Width="19" Height="19" Stretch="Uniform" Margin="0,0,8,0"/>
            <TextBlock x:Name="AppTitleTextBlock" Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[about_title]}"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 搜索框放在标题栏里（最小化/最大化/关闭同一行）。
             shell:WindowChrome.IsHitTestVisibleInChrome=True 必不可少：不然 WindowChrome
             会把这一行当成标题栏拖动区，点不进去、也打不了字。 -->
        <Border Grid.Row="0" Width="320" Height="24" HorizontalAlignment="Right" Margin="0,0,142,0"
                VerticalAlignment="Center" CornerRadius="12"
                Background="{DynamicResource ControlFillBrush}"
                BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                <TextBox x:Name="TitleSearchBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0" Padding="12,0,0,0"
                         Template="{StaticResource TitleSearchBoxTemplate}"
                         FontSize="12.5" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         TextChanged="TitleSearchBox_TextChanged"
                         KeyDown="TitleSearchBox_KeyDown"
                         PreviewKeyDown="TitleSearchBox_PreviewKeyDown"/>
                <!-- 提示文字比光标再往右 8px：光标固定在 12px，提示文字放 20px，
                     这样空输入时那个闪烁的竖线不会紧贴/压住提示字（用户要求留点间隔）。
                     代价是第一次敲字时文字出现在 12px、提示字在 20px，有一次很小的跳动。 -->
                <TextBlock x:Name="TitleSearchHint" Grid.Column="1" Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[nav_search]}"
                           FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0" IsHitTestVisible="False"/>
                <Button x:Name="TitleSearchButton" Grid.Column="2" Width="26" Height="22" Margin="0,0,1,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleBarIconButton}" Click="TitleSearchButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[nav_search]}">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MiniMinButton" Style="{StaticResource CaptionButton}" Click="MiniMinButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}" Click="MaxRestoreButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
                <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="CloseCaptionButton" Style="{StaticResource CaptionButton}" Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- 最近播放 / 我的收藏 右滑抽屉 -->
        <Border x:Name="HistoryDrawer" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="360" Background="{DynamicResource FlyoutBgBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HistoryDrawerTranslate" X="360"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="-4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="16,14,10,8">
                    <Button x:Name="HistoryDrawerCloseButton" DockPanel.Dock="Right" Width="30" Height="30"
                            Style="{StaticResource GhostButtonStyle}" Click="HistoryDrawerCloseButton_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="HistoryClearButton" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,5"
                            Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"
                            Click="HistoryClearButton_Click"/>
                    <TextBlock x:Name="HistoryDrawerTitle" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,10">
                    <Border Background="{DynamicResource SubtleFillHoverBrush}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DrawerRecentTab" Padding="16,6" Cursor="Hand" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold"
                                    Click="DrawerRecentTab_Click"/>
                            <Button x:Name="DrawerFavTab" Padding="16,6" Cursor="Hand" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold"
                                    Click="DrawerFavTab_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                    <StackPanel x:Name="DrawerList"/>
                </ScrollViewer>
                <TextBlock x:Name="DrawerEmptyText" Grid.Row="2" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="30" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 浮动提示条：浮于一切内容之上，不顶动内容 -->
        <StackPanel x:Name="ToastPanel" Grid.RowSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,44,0,0" MaxWidth="600"
                    IsHitTestVisible="False"/>

    </Grid>
</Window>
