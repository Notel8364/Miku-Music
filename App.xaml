<Application x:Class="MusicBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MusicBox.Controls">
    <!-- 这里刻意不写 StartupUri：StartupUri 会在 OnStartup 之前就把 MainWindow 建出来，
         单实例守卫就来不及了（第二个实例会把窗口、播放、SMTC、热键、托盘全建一遍再退出）。
         主窗口改为在 App.OnStartup 里抢到锁之后再手工创建。 -->
    <Application.Resources>
        <!-- ============================================================
             主题令牌（对齐 WinUI 3 深色主题 / MhyunBox 观感）
             卡片是「半透明白 5%」而非不透明白，因此底图/动态背景能透上来，
             文字一律浅色——这与旧版「浅色卡片 + 深色文字」是两套配色。
             ============================================================ -->

        <!-- 强调色：AccentBrush 由 MainWindow.ApplyAccentTheme 在运行时改写，
             悬停/按下色由该方法按基色推算后一并写入，样式一律走 DynamicResource 跟随。 -->
        <Color x:Key="AccentColor">#1C1C1C</Color>
        <Color x:Key="AccentHoverColor">#55A2FF</Color>
        <Color x:Key="AccentPressedColor">#2D74DA</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#55A2FF"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#2D74DA"/>
        <!-- 强调色上的字色。默认值配合默认的蓝色强调色；
             换色时由 MainWindow.ApplyAccentTheme 按亮度重算后覆盖。 -->
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>

        <!-- 层级底色 -->
        <SolidColorBrush x:Key="PageBgBrush" Color="#0C0C0C"/>
        <SolidColorBrush x:Key="LayerBgBrush" Color="#202020"/>
        <SolidColorBrush x:Key="PaneBgBrush" Color="#1C1C1F"/>

        <!-- 卡片（MhyunBox：CardBackgroundFillColorDefault / CardStrokeColorDefault） -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="CardBgSecondaryBrush" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>

        <!-- 文本三级 -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8FFFFFF"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8AFFFFFF"/>

        <!-- 控件填充/描边 -->
        <SolidColorBrush x:Key="ControlFillBrush" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#21FFFFFF"/>
        <SolidColorBrush x:Key="ControlStrokeBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="ControlStrokeHoverBrush" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="SubtleFillBrush" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="FlyoutBgBrush" Color="#F21C1C1C"/>
        <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="TrackBgBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="DisabledFgBrush" Color="#5FFFFFFF"/>

        <!-- 下面四个没有单独的隐式样式消费方，主要给代码里现建控件的页面用
             （在线搜索的输入框、加载遮罩、视频背景卡片蒙版）。切浅色主题时
             ThemeManager 会一起改写，所以引用它们的地方用 DynamicResource。 -->
        <SolidColorBrush x:Key="InputBgBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="OverlayBgBrush" Color="#B01A1A1A"/>
        <SolidColorBrush x:Key="VideoCardMaskBrush" Color="#C00E0E0E"/>

        <!-- 列表项选中底（强调色的低透明叠加，替代旧版实色蓝） -->
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#331C1C1C"/>
        <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="#4D1C1C1C"/>

        <!-- ==================== 隐式控件样式（深色） ==================== -->

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <!-- 跟着 HorizontalContentAlignment/VerticalContentAlignment 走，别写死 Center。
                                 写死的话任何「内容要撑满」的按钮（比如搜索建议行）设了 Stretch 也没用，
                                 内容还是居中。Button 这两个属性的默认值本来就是 Center，
                                 所以其它按钮外观一个字都不会变。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillPressedBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="9,0,9,0" VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M0,4.5 L3.5,8 L9,1" Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="11" Height="9" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource ControlStrokeBrush}"
                                         StrokeThickness="1"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Dot" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 弹层在 hwnd 创建瞬间会先摆到屏幕 (0,0) 再移到锚点，露出一帧
             就是在桌面左上角「闪一下」。PopupFlashGuard 在开启那一拍把内容
             先置透明、落位后再显形，glitch 从此画不出来。全局对所有 ComboBox 生效。 -->
        <Style TargetType="ComboBox">
            <Setter Property="ctl:PopupFlashGuard.Silence" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Tx" Focusable="False" ClickMode="Press" Margin="0"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TbBd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                CornerRadius="7"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                                  IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                                   VerticalOffset="4">
                                <Border Background="{DynamicResource FlyoutBgBrush}"
                                        BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="400" Margin="0,3,0,0">
                                    <!-- 横向必须关掉：一旦某条选项文字过宽冒出横向滚动条，
                                         视口宽度会变，列表内容整体位移，看上去就是「滚动时整条列表漂移」。
                                         另外 PopupAnimation 不能用 Slide：Slide 会给 Popup 根加位移动画，
                                         里面再嵌一个能滚动的 ScrollViewer 时两者会叠加，
                                         滚一下内容就跟选项框脱开、往一边跑。 -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="BorderBrush" Value="{DynamicResource ControlStrokeHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Tx" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条：细窄深色，悬停才显形（WinUI 行为） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Bar" Margin="2,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- 走主题画刷：之前写死 #4DFFFFFF / #80FFFFFF（白色），
                                                     浅色主题下就是白底白滑块，等于看不见滚动条。
                                                     TextTertiary/TextSecondary 两套配色都有，
                                                     深浅主题下都能看清又不抢眼。 -->
                                                <Border x:Name="ThumbBd" Background="{DynamicResource TextTertiaryBrush}"
                                                        CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <!-- 竖向是 2,0（左右留白），横向要反过来 0,2 -->
                                <Setter TargetName="Bar" Property="Margin" Value="0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 主/次按钮 ==================== -->

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <!-- 跟着强调色亮度走的字色。写死白字的话，
                 强调色选「纯白」就会变成白底白字，按钮上的字整个消失。 -->
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 颜色走 Trigger 而非 ColorAnimation：Storyboard 是共享的冻结对象，
                                 在里面用 DynamicResource 解析主题色不可靠。
                                 按下缩放直接整体替换 RenderTransform：RenderTransform 里的
                                 ScaleTransform 不在模板 namescope 内，Setter/Storyboard 都点不到它。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 同上：颜色用 Trigger 换整支画刷，绝不去改共享冻结画刷的 Color。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillPressedBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方形图标按钮：锐角 + 零内边距。
             不能拿 GhostButtonStyle 只改 Width/Height 了事 ——
             那个模板把 Padding 写死成 16,9，26x26 的按钮扣掉 2px 边框和
             32px 左右内边距后内容区是 -8 宽，ContentPresenter 被压成 0，
             图标整个被裁掉，表现就是一个「空按钮」。
             CornerRadius 同理：Button 本身没有这个属性，写 CornerRadius="0"
             是无效设置，圆角硬编码在模板内部的 Bd 上。 -->
        <Style x:Key="IconSquareButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" RenderOptions.EdgeMode="Aliased">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 颜色色块。
             必须显式给样式，不能让色块吃隐式 Button：隐式样式带 1px 的
             ControlStrokeBrush 描边和 14,7 内边距，于是每个色块左右各多一条
             1px 浅色竖线，一排色块看上去像被白竖线切开了；内边距还把 30x30
             的色块撑大，六个一行排不下。
             悬停只加一圈外描边、不换底色：底色就是这个色本身，hover 换成
             SubtleFillHoverBrush 会让用户以为点的是另一个颜色。 -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 选中环画在按钮外面一圈，和底色分开，
                                 这样白/浅色的色块也能看见自己被选中。 -->
                            <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2"
                                    CornerRadius="8"/>
                            <Border x:Name="Chip" Margin="3" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush"
                                        Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 歌词悬浮窗标题条上的小按钮。开着的时候用强调色的淡底表示状态，
             不开就是透明，这个区别要一眼能看出来，否则用户不知道当前是哪种模式。 -->
        <Style x:Key="MiniToggleButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- Foreground 必须显式给。MiniToggleButton 是显式 Style，
                 不会去继承隐式样式，而 WPF 里 ToggleButton 的 Foreground
                 默认就是黑色：歌词弹窗是深色底，黑图标等于看不见
                 （这正是「键位太黑」的原因）。
                 TextPrimaryBrush 由 ThemeManager 按色调下发：
                 深色主题下发白色、浅色主题下发深色，所以「黑底给白字」
                 这件事跟着主题走，不用在每个按钮上手写颜色。 -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <!-- 歌词悬浮窗底部播放键（上一首 / 播放暂停 / 下一首）。
             和 MiniToggleButton 同一套外观，区别只是它是 Button 不是
             ToggleButton —— 没有「开着」那种淡强调底，它不是开关。
             单独抽出来是因为 WPF 的 Button/ToggleButton 不共享隐式样式，
             给 ToggleButton 写的模板套到 Button 上会在解析期报 TargetType 不匹配，
             整个歌词窗都建不出来（CloseButton 之前就踩过这个）。 -->
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- 和 MiniToggleButton 同一个理由：Button 的 Foreground 默认也是黑色，
                 深色底上等于看不见。跟主题走，不在每个按钮上手写颜色。 -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
