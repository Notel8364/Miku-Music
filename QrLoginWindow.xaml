<Window x:Class="MusicBox.QrLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码登录"
        Width="340" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource FlyoutBgBrush}"
        ShowInTaskbar="False">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                <Grid Width="200" Height="200">
                    <Image x:Name="QrImage" Stretch="Uniform"/>
                    <Border x:Name="QrMask" Background="#CC1C1C1C" CornerRadius="4" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="MaskText" Text="" Foreground="White" FontSize="13" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="8,0"/>
                            <Button x:Name="RefreshInMaskButton" Content="刷新二维码" Padding="10,5" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Click="RefreshButton_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LoadingText" Text="正在获取二维码…" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"
                       Text="请使用网易云音乐 App 扫码登录"/>
        </StackPanel>
    </Border>
</Window>
