<UserControl x:Class="MusicBox.Pages.RecentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <Button x:Name="ClearRecentButton" Content="清空" Padding="12,6" DockPanel.Dock="Right"
                        Margin="10,0,0,0" Visibility="Collapsed" Click="ClearRecentButton_Click"/>
                <StackPanel>
                    <!-- 标题下面那行说明按用户要求去掉了：「用户自己会探索和学怎么用的，
                         尽量减少过多提示注释」。 -->
                    <TextBlock Text="最近播放" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl x:Name="RecentList"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="暂无最近播放记录" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" MinHeight="16"/>
    </Grid>
</UserControl>