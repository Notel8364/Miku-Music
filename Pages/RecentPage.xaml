<UserControl x:Class="MusicBox.Pages.RecentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:MusicBox.Services"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button x:Name="ClearRecentButton" Content="{Binding Source={x:Static loc:Loc.Default}, Path=Item[recent_clear]}"
                    Padding="12,6" DockPanel.Dock="Right"
                    Margin="10,0,0,0" Visibility="Collapsed" Click="ClearRecentButton_Click"/>
            <!-- 搜索栏。DockPanel.Dock="Right" 的先排，所以顺序上它在标题右边、
                 「清空」按钮再往右 —— 三个控件从右往左依次是 清空 / 搜索 / 标题。
                 清除键叠在输入框右侧，压在上面而不是重写 TextBox 模板。 -->
            <Grid DockPanel.Dock="Right" Width="240" Height="30" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox" HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Center" FontSize="13"
                         Padding="8,0,28,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                         ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[lib_search_hint]}"/>
                <Button x:Name="ClearSearchButton" Width="24" Height="24" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                        Click="ClearSearchButton_Click" ToolTip="{Binding Source={x:Static loc:Loc.Default}, Path=Item[act_clear_search]}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </Button>
            </Grid>
            <StackPanel>
                <!-- 标题和下面那句说明原来直接写死中文，切到英文/日文界面这里还是中文。
                     改成绑 Loc 的 key，和左侧导航栏用同一批键。 -->
                <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[recent_title]}"
                           FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- 平台过滤勾选行：勾哪个只看哪个平台的记录，全部勾上=显示全部（默认）。
             勾选状态存 Settings（RecentPlatformsOff 记被关掉的平台），重启保留。
             复选框在代码里按 Loc 文案生成（六语言），样式与设置页普通勾选一致。 -->
        <StackPanel x:Name="PlatformFilterPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                    Visibility="Collapsed">
            <TextBlock x:Name="PlatformFilterLabel" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <WrapPanel x:Name="PlatformFilterChecks" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <!-- 滚动到接近底部（200px 内）时向下补一批行，见 RecentScroll_ScrollChanged -->
                <ScrollViewer x:Name="RecentScroll" VerticalScrollBarVisibility="Auto" Padding="6"
                              ScrollChanged="RecentScroll_ScrollChanged">
                    <ItemsControl x:Name="RecentList"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" TextAlignment="Center" Margin="40,0"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" MinHeight="16"/>
    </Grid>
</UserControl>