<UserControl x:Class="MusicBox.Pages.OnlineMusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:MusicBox.Services"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <!-- 标题下的说明文字按用户要求去掉了：搜索框已经挪到窗口标题栏，
                 这里只留「搜索音乐」标题 + 四个源的单选行。 -->
            <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[nav_search]}"
                       FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- 四个源单独一行，单选。点谁就显示谁的列表。 -->
            <Border x:Name="EnginePanelBorder" Margin="0,12,0,0"
                    Background="{DynamicResource CardBgBrush}" CornerRadius="9"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="4">
                <StackPanel x:Name="EnginePanel" Orientation="Horizontal"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <!-- 左边音乐列表收窄，右边腾出常驻评论区。
                     原来评论是盖在列表上的浮层，点不到（也就「打不开」），
                     现在它是卡片右半边固定的一栏，不用点开就有位置。 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="OnlineScroll" Grid.Row="0" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto" Padding="6,6,6,2"
                              CanContentScroll="False">
                    <ItemsControl x:Name="OnlineList" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <!-- 固定用 StackPanel。行是代码 new 出来直接塞进
                                 OnlineList.Items 的普通 Grid，本来就没有虚拟化；
                                 显式写死可以避免任何默认面板将来被换成
                                 VirtualizingStackPanel 而重演那次
                                 ApplyItemContainerStyle 崩溃。 -->
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <!-- 分页页脚：固定在列表卡片底部居中，不再跟着列表一起滚。
                     上一页 / 页码 / 下一页 三个控件贴在一起，外面套一个圆角底。 -->
                <Border x:Name="FooterHost" Grid.Row="1" Grid.Column="0" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                        Padding="3" CornerRadius="9"
                        Background="{DynamicResource CardBgSecondaryBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource OverlayBgBrush}"
                      IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="LoadingRotate"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="LoadingText" Text="" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="HintText" Grid.RowSpan="2" Grid.Column="0" Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[online_hint]}"
                           FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- B站视频源面板：VIP 受限时列出候选视频源，供用户挑选下载/播放。
                     只盖左边的列表区，不再压住右边的评论区。 -->
                <Border x:Name="BiliSourcePanel" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource FlyoutBgBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="10" Visibility="Collapsed" MaxHeight="320"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="14,10,10,6">
                            <Button x:Name="BiliSourceCloseButton" DockPanel.Dock="Right" Width="30" Height="30"
                                    Style="{StaticResource GhostButtonStyle}" Click="BiliSourceCloseButton_Click">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="BiliSourceHeaderText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="BiliSourceSubText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,0">
                            <StackPanel x:Name="BiliSourceList"/>
                        </ScrollViewer>
                        <TextBlock x:Name="BiliSourceStatusText" Grid.Row="2" Margin="14,6,14,10" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ============ 右侧常驻评论区 ============
                     原来是盖在列表底部的浮层（MaxHeight 240 + Margin 10），
                     视觉上像贴在列表里的一张小卡片，而且被列表内容压着不好点。
                     现在它是卡片右半边固定一栏：左缘一条 1px 分隔线，
                     任何时候都在，不会「打不开」。 -->
                <Border x:Name="CommentPanel" Grid.RowSpan="2" Grid.Column="1" Width="340"
                        Background="{DynamicResource CardBgSecondaryBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0"
                        CornerRadius="0,10,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 标题行。原来这里还挂了一个「关闭/清除评论」按钮，
                             看着像面板的关闭键，实际干的是「清空评论并收回空态」，
                             和点同一首歌的评论键（重新加载）功能重叠，而且更容易误触。
                             现在去掉：要看哪首歌的评论就点哪首的评论键，
                             再点一次同一首则收起面板（见 OpenComments 里的 toggle）。
                             底部 margin 保留 16，是为了让标题和列表右缘有分层，
                             不然标题会紧贴最后一条评论。 -->
                        <TextBlock x:Name="CommentHeaderText" Grid.Row="0" Margin="14,12,16,10"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- 登录提示独占一行。原来它和评论列表同在 Row=1，
                             列表是后声明的所以盖在上面，视觉上就是
                             「发表评论」这行字和评论内容糊在一起。 -->
                        <TextBlock x:Name="CommentLoginHint" Grid.Row="1" VerticalAlignment="Top"
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="14,0,14,8"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- 列表本体。默认是 Collapsed —— 「评论列表」由用户点评论按钮才展开，
                             关闭后退回空态。原来 CommentScroll 常驻 Visible，
                             拿 CommentPlaceholderText 盖在上面，等于列表区域一直占着，
                             用户看到的就是「默认打开了」。 -->
                        <Grid Grid.Row="2" x:Name="CommentBodyHost" Visibility="Collapsed">
                            <ScrollViewer x:Name="CommentScroll" VerticalScrollBarVisibility="Auto" Padding="14,0,14,0"
                                          ScrollChanged="CommentScroll_ScrollChanged">
                                <StackPanel x:Name="CommentList"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- 空态。没点开评论时显示，撑住这一栏不至于一片空白。 -->
                        <TextBlock x:Name="CommentPlaceholderText" Grid.Row="2" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" Margin="16"
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[cm_pick_hint]}"/>

                        <!-- 状态行独占一行。原来的评论条数（cm_count）已经不再显示：
                             评论数对用户没有决策价值，还占掉了底部空间。
                             这里只留加载中 / 出错 / 无评论 / 已到底。
                             状态文字和「加载更多」提示共用这一行，
                             由 SetCommentStatus 保证两者互斥，不会叠字。 -->
                        <TextBlock x:Name="CommentStatusText" Grid.Row="3" VerticalAlignment="Center"
                                   Margin="14,4,14,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <!-- 触底提示。放在列表下面那一行，不浮在评论内容上面。 -->
                        <TextBlock x:Name="CommentMoreHint" Grid.Row="3" VerticalAlignment="Center"
                                   Margin="14,4,14,0" FontSize="11.5" Opacity="0.85"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"/>

                        <!-- 底部发表评论输入框。默认显示（原来默认 Collapsed，
                             于是「面板开着但没法发评论」看着像功能坏了）。
                             能不能输入由 RefreshComposeState 按平台和登录态决定：
                             支持的平台放开，否则保持禁用并在上面那行说明原因。 -->
                        <Border x:Name="CommentComposeBar" Grid.Row="4" Margin="12,8,12,12"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="CommentInputBox" Margin="10,8,10,0"
                                         IsEnabled="False" AcceptsReturn="False" MaxLength="1000"
                                         FontSize="13" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         TextChanged="CommentInputBox_TextChanged" KeyDown="CommentInputBox_KeyDown"/>
                                <Button x:Name="CommentSendButton" Grid.Row="1" Margin="10,6,10,8"
                                        HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,5" FontSize="12" IsEnabled="False"
                                        Click="CommentSendButton_Click"
                                        Content="{Binding Source={x:Static loc:Loc.Default}, Path=Item[cm_send]}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 状态行。没有内容时 Visibility=Collapsed，整行高度归零，
             列表就能一直铺到卡片底部。原来固定 MinHeight=15 + Margin=4，
             哪怕一个字都没有也常驻 19px，列表底部永远悬着一截空白。
             StatusText 本身保留，代码里那些赋值照旧生效，
             由 SetStatus() 统一同步可见性。 -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,4,0,0" FontSize="12.5"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" MinHeight="15" Visibility="Collapsed"/>
    </Grid>
</UserControl>
