<UserControl x:Class="MusicBox.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:MusicBox.Services"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,10,10">
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="22" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- logo 只约束宽度、不固定高度：固定 Width+Height 的方盒子会把
                             非正方形的原图压扁（画布内容被 Uniform 缩进盒子后上下留边，
                             视觉上就是「高度小于原始比例」）。只留 Width + Uniform，
                             高度跟随原图比例自然撑出，按原图比例完整显示；
                             水平 StackPanel 自适应行高，不会溢出卡片。 -->
                        <Image x:Name="AppIcon" Width="76" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                            <!-- 标题下面原来还有一句宣传语 + 一行版本号。用户要的是
                                 「Miku Music 只留一个版本号」，所以宣传语去掉，版本号只留这一行。 -->
                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[about_title]}"
                                       FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="VersionText" Text="v2.1.0" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[about_os_title]}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[about_os_note]}"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel x:Name="CreditsPanel"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[about_principles_title]}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[about_principles_note]}"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel x:Name="PrinciplesPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,10,0" Padding="0,10,0,6">
            <TextBlock HorizontalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="Powered By "/><Run Text="OpenCode" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AccentBrush}"/><Run Text=" &amp; "/><Run Text="TRAE Solo" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AccentBrush}"/><Run Text=" &amp; "/><Run Text="WorkBuddy" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AccentBrush}"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
