<UserControl x:Class="MusicBox.Pages.MusicLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="音乐库 / 视频" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <DockPanel Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ChooseFolderButton" Content="选择音乐文件夹" Padding="14,8" Margin="6,0,0,0"
                            Click="ChooseFolderButton_Click"/>
                    <Button x:Name="RefreshButton" Content="刷新" Padding="14,8" Margin="6,0,0,0"
                            Click="RefreshButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" FontSize="13"/>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                    <TextBlock x:Name="CountText" Text="音乐库 (0 首)" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                    <!-- 「保留关键词」：不勾时每次跳去别的页面再回来都从全部歌曲开始，
                         勾上则记住这次的筛选词。默认不勾 —— 「看到一半去设置页回来看一眼
                         结果列表突然全量了」比「每次都要重输一遍关键词」更让人困惑，
                         但记住不记住是个人习惯，所以给个开关。 -->
                    <CheckBox x:Name="KeepFilterCheckBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                              Margin="10,0,0,0" Content="保留关键词" FontSize="12.5" Cursor="Hand"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              ToolTip="勾上：跳去别的页面再回来，保留这次的筛选关键词&#10;不勾：每次跳转别的页面就清空筛选"
                              Checked="KeepFilterCheckBox_Changed" Unchecked="KeepFilterCheckBox_Changed"/>
                    <TextBox x:Name="SearchBox" Width="240" Height="30" HorizontalAlignment="Right"
                             VerticalContentAlignment="Center" FontSize="13" TextChanged="SearchBox_TextChanged"
                             ToolTip="输入关键字筛选，忽略空格和标点（搜 cu 能找到 C U Again）" DockPanel.Dock="Right"/>
                </DockPanel>
                <ListBox x:Name="LibraryListBox" BorderThickness="0" Background="Transparent" Padding="6"
                         SelectionMode="Single"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="LibraryListBox_MouseDoubleClick"
                         ContextMenuOpening="LibraryListBox_ContextMenuOpening">
                    <ListBox.ItemContainerStyle>
                        <!-- ListBoxItem 自带一圈内边距，行的封面和标题会比
                             「最近播放 / 我的收藏」那两个列表往里缩一截，
                             换页过去时同一首歌的标题对不齐，看着像两套格式。
                             这里把容器内边距清零，行本身已经有 Padding，
                             由 TrackRows.BuildRow 统一负责。 -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="播放" Click="ContextPlay_Click"/>
                            <MenuItem Header="标记/取消跳过" Click="ContextToggleSkip_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
