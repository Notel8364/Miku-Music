<UserControl x:Class="MusicBox.Pages.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="我的收藏" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                <Button x:Name="SyncButton" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Padding="14,7" Style="{StaticResource AccentButtonStyle}"
                        Click="SyncButton_Click" Content="从云端同步"/>
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl x:Name="FavList"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="还没有收藏" FontSize="14"
                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" Margin="40,0"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" MinHeight="16"/>
    </Grid>
</UserControl>