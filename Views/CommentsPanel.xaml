<UserControl x:Class="MusicBox.Views.CommentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:MusicBox.Services"
             mc:Ignorable="d">
    <!-- 第三界面：贴窗口右缘的评论抽屉。挂在 MainWindow.RootGrid 的 Row=1、
         状态提示条（ToastPanel）声明在它之后，仍然压在它上面。
         Root 是右对齐的整高卡片，滑入滑出作用在它自己的 RenderTransform 上。 -->
    <Border x:Name="Root" Width="360"
            HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Margin="0,10,0,80"
            Background="{DynamicResource FlyoutBgBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="10,0,0,10">
        <Border.Effect>
            <!-- 阴影朝左（Direction=180），朝程序里那一侧投：面板贴在右缘，
                 光从右边来才像一块浮在页面上方的板子，不然影子被窗口裁掉等于没有。
                 加深加宽，让「压在上面」这层关系一眼看得出来。 -->
            <DropShadowEffect BlurRadius="38" ShadowDepth="7" Direction="180"
                              Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：曲目名 + 关闭键。
                 旧布局这里没有关闭键（「点同一首的评论键再收起」是常驻栏时代的规矩），
                 抽屉化之后必须有：面板会盖住搜索页右半边和全屏页，
                 没有显式关闭键就只剩 Esc 和再点一次行内评论键两条路。 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CommentHeaderText" Grid.Column="0"
                           Margin="14,12,6,10"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button x:Name="CommentCloseButton" Grid.Column="1"
                        Width="30" Height="30" Margin="0,0,8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CommentCloseButton_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>

            <!-- 登录提示独占一行，别和评论列表叠在一起糊字。 -->
            <TextBlock x:Name="CommentLoginHint" Grid.Row="1" VerticalAlignment="Top"
                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                       Margin="14,0,14,8"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- 列表本体。默认 Collapsed —— 「评论列表」由用户点评论按钮才展开，
                 关闭后退回空态。 -->
            <Grid Grid.Row="2" x:Name="CommentBodyHost" Visibility="Collapsed">
                <ScrollViewer x:Name="CommentScroll" VerticalScrollBarVisibility="Auto"
                              Padding="14,0,14,0"
                              ScrollChanged="CommentScroll_ScrollChanged">
                    <StackPanel x:Name="CommentList"/>
                </ScrollViewer>
            </Grid>

            <!-- 空态。没点开评论时显示，撑住这一栏不至于一片空白。 -->
            <TextBlock x:Name="CommentPlaceholderText" Grid.Row="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="240" Margin="16"
                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="{Binding Source={x:Static loc:Loc.Default}, Path=Item[cm_pick_hint]}"/>

            <!-- 状态行。加载中 / 出错 / 无评论 / 已到底；
                 和「加载更多」提示共用这一行，由 SetCommentStatus 保证互斥。 -->
            <TextBlock x:Name="CommentStatusText" Grid.Row="3" VerticalAlignment="Center"
                       Margin="14,4,14,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <!-- 触底提示。放在列表下面那一行，不浮在评论内容上面。 -->
            <TextBlock x:Name="CommentMoreHint" Grid.Row="3" VerticalAlignment="Center"
                       Margin="14,4,14,0" FontSize="11.5" Opacity="0.85"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Visibility="Collapsed"/>

            <!-- 发表评论输入框。能不能输入由 RefreshComposeState 按平台和登录态决定。 -->
            <Border x:Name="CommentComposeBar" Grid.Row="4" Margin="12,8,12,12"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CommentInputBox" Margin="10,8,10,0"
                             IsEnabled="False" AcceptsReturn="False" MaxLength="1000"
                             FontSize="13" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="CommentInputBox_TextChanged"
                             KeyDown="CommentInputBox_KeyDown"/>
                    <Button x:Name="CommentSendButton" Grid.Row="1" Margin="10,6,10,8"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="14,5" FontSize="12" IsEnabled="False"
                            Click="CommentSendButton_Click"
                            Content="{Binding Source={x:Static loc:Loc.Default}, Path=Item[cm_send]}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
