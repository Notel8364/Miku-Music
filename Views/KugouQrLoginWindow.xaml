<Window x:Class="MusicBox.KugouQrLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="酷狗扫码登录" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource FlyoutBgBrush}"
        BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
        WindowStyle="ToolWindow">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="TipText" Text="打开酷狗音乐 App，扫一扫登录"
                   FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Border Width="200" Height="200" Margin="0,14,0,10" CornerRadius="8"
                Background="White" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Stretch="Uniform" Margin="10"/>
        </Border>
        <TextBlock x:Name="StateText" Text="正在获取二维码…"
                   FontSize="12.5" HorizontalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Button x:Name="RetryButton" Content="刷新二维码" Padding="14,7" Margin="0,12,0,0"
                HorizontalAlignment="Center" Visibility="Collapsed"
                Style="{StaticResource AccentButtonStyle}" Click="RetryButton_Click"/>
    </StackPanel>
</Window>
